{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kexu-campus-mvp",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "assets": { "directory": "./dist-campus", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "observability": { "enabled": true }
}
